{
  "name": "webservice",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "start": "npm run dev",
    "seo:generate": "node scripts/generate-seo-pages.mjs",
    "deadlines:create-wave": "node scripts/deadlines/create-wave.mjs",
    "deadlines:build": "node scripts/deadlines/consolidate.mjs",
    "deadlines:check": "node scripts/deadlines/consolidate.mjs --check",
    "build": "npm run deadlines:build && npm run seo:generate && node scripts/build-static.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "vite": "^5.4.14"
  }
}
