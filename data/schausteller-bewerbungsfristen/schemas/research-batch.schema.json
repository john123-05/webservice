{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://impress-rank.de/schemas/research-batch.schema.json",
  "title": "Schausteller Research Batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_id",
    "region_scope",
    "search_terms",
    "max_expected_results",
    "source_policy",
    "researched_at",
    "entries",
    "rejected_candidates",
    "review_candidates"
  ],
  "properties": {
    "batch_id": { "type": "string", "minLength": 1 },
    "region_scope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "search_terms": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "max_expected_results": { "type": "integer", "minimum": 1, "maximum": 100 },
    "source_policy": { "const": "official_only" },
    "researched_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "entries": {
      "type": "array",
      "items": { "$ref": "frist-entry.schema.json" }
    },
    "rejected_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_name", "candidate_url", "reason"],
        "properties": {
          "event_name": { "type": "string" },
          "candidate_url": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "review_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_name", "candidate_url", "reason"],
        "properties": {
          "event_name": { "type": "string" },
          "candidate_url": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
