{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://impress-rank.de/schemas/frist-entry.schema.json",
  "title": "FristEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "event_name",
    "event_type",
    "city",
    "state",
    "country",
    "venue_or_area",
    "application_deadline_iso",
    "application_deadline_text",
    "event_date_range_text",
    "application_mode",
    "postal_address",
    "contact_name",
    "contact_email",
    "contact_phone",
    "source_url",
    "source_domain",
    "source_kind",
    "last_verified_at",
    "agent_batch_id",
    "confidence_status",
    "notes"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "event_name": { "type": "string", "minLength": 1 },
    "event_type": { "type": "string" },
    "city": { "type": "string", "minLength": 1 },
    "state": { "type": "string", "minLength": 1 },
    "country": { "const": "DE" },
    "venue_or_area": { "type": "string" },
    "application_deadline_iso": { "type": "string", "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "application_deadline_text": { "type": "string" },
    "event_date_range_text": { "type": "string" },
    "application_mode": { "type": "string" },
    "postal_address": { "type": "string" },
    "contact_name": { "type": "string" },
    "contact_email": { "type": "string" },
    "contact_phone": { "type": "string" },
    "source_url": { "type": "string", "format": "uri" },
    "source_domain": { "type": "string", "minLength": 1 },
    "source_kind": { "const": "official" },
    "last_verified_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "agent_batch_id": { "type": "string", "minLength": 1 },
    "confidence_status": { "enum": ["verified", "partial", "needs_review"] },
    "notes": { "type": "string" }
  }
}
